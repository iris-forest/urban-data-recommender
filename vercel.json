{
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/_/backend",
      "runtime": "python3.11",
      "entrypoint": "python -m uvicorn app.api:app --host 0.0.0.0 --port 8080"
    }
  }
}
