# Optional overrides for `docker compose --env-file compose.env up`
# Copy to compose.env and adjust as needed.

# Live API search during catalog/recommendation calls
# ENABLE_MADRID_CKAN=true
# ENABLE_DATOS_GOB_ES=true

# MADRID_CKAN_ROWS=50
# MADRID_CKAN_QUERY=
# DATOS_GOB_ES_PAGE=1
# DATOS_GOB_ES_LIMIT=50

# Optional LLM enrichment for summaries/fit analysis
# ENABLE_LLM_INSIGHTS=false
# LLM_PROVIDER=none
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# CORS only needed if you expose the backend directly on another origin
# CORS_ORIGINS=http://localhost:8080
